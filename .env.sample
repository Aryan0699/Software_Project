NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uras?schema=public
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# Authentication
SESSION_COOKIE_NAME=uras_session
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_PER_15_MIN=20

# Booking timeline and selection rules, expressed as minutes after midnight.
BOOKING_TIMELINE_START_MINUTE=480
BOOKING_TIMELINE_END_MINUTE=1320
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_SELECTION_STEP_MINUTES=10
BOOKING_DEFAULT_DURATION_MINUTES=60

# Required only when Google login is enabled.
GOOGLE_CLIENT_ID=

# Optional one-time administrator bootstrap used by `npm run seed`.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
